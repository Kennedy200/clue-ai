# Clue AI API + worker image (same image, two commands). Build from the repo root:  docker build -f infra/Dockerfile.api -t clue-api .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HUB_DISABLE_SYMLINKS_WARNING=1 STORAGE_PATH=/data

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg espeak-ng libsndfile1 curl fonts-dejavu-core fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api/requirements.txt apps/api/requirements.txt
RUN pip install -r apps/api/requirements.txt

COPY apps/api apps/api
COPY plugins plugins
COPY content content
COPY infra/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && useradd -m clue && mkdir -p /data && chown -R clue /data /app
USER clue

WORKDIR /app/apps/api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
ENTRYPOINT ["/entrypoint.sh"]
CMD ["api"]
