# --- Mode ---
APP_MODE=self_host            # self_host | saas
# --- Ports / URLs ---
WEB_PORT=3000
API_PORT=8000
SITE_URL=http://localhost:3000
# --- LLM (the ONLY key you need). Or paste it at /setup ---
OPENROUTER_API_KEY=
# Optional: override discovered free models (leave blank to pick in Admin)
MODEL_FAST=
MODEL_SMART=
# Optional local LLM
OLLAMA_URL=
# --- Paths ---
STORAGE_PATH=./storage
# --- Admin bootstrap ---
ADMIN_EMAIL=admin@clue.local
# --- Feature flags ---
FEATURE_URL_IMPORT=false
# --- Real email (optional; without it, messages go to the local dev inbox at /dev-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
